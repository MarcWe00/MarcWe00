		$+
(		WHILE E[eJobRes]<>2 DO)
(			G4F.1)
(		ENDW)
			
		(~~~~~ Spannzange => Greifer FT ~~~~~)
		IF [Back]>0 THEN
			G77H21000N1104
			$=[Back]
			G77H21000N1106
			
			(Palettendaten FT anfordern)
			[PalWkstNr]=[Back]
			G77N10400N10499
			
			IF 'EL=0 THEN
