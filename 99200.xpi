	G77H21000N1102
	
	VAR H9823:1		(Daten Huelsenwechsel einlesen)
		
	(GreiferRT geschlossen mit Wkst + keine WkstNr im GreiferRT)
	IF E[eGrZ_RT]=2 AND E[ePceGrRT]=0 THEN
		E[MeldNr]=13
		G79 N9000
	ENDI
	
	(GreiferFT geschlossen mit Wkst + keine WkstNr im GreiferFT)
	IF E[eGrZ_FT]=2 AND E[ePceGrFT]=0 THEN
		E[MeldNr]=14
		G79 N9000
	ENDI
	
	(Futter geschlossen + keine WkstNr im Futter)
	IF E[eSpZust]=2 AND E[ePceNr0]=0 THEN
		E[MeldNr]=15
		G79 N9000
	ENDI
	
	(Futter geoeffnet + WkstNr im Futter)
	IF E[eSpZust]=1 AND E[ePceNr0]<>0 THEN
		E[MeldNr]=15
		G79 N9000
	ENDI
	
	(WkstNr im GreiferRT + WkstNr im GreiferFT)
	IF E[ePceGrRT]<>0 AND E[ePceGrFT]<>0 THEN
		E[MeldNr]=16
		G79 N9000
	ENDI
	
	(Futter geschlosen + WkstNr im Futter > zu ladende WkstNr -> zu ladene Nr-1 setzen, da HP nur abfolgend abzeilt)
	IF E[eSpZust]=2 AND E[ePceNr0]>'EL AND 'EL<>0 THEN
		E[ePceNr0]='EL-1
	ENDI
	
	

	(Huelsenwechsel)
	IF [Chg_Hue]=1 AND 'EL<>0 THEN
		[HuelseDur]=E[ePceSL1]/1000    	(Hülsendurchmesser)
		G77N10210N10299						
		[Chg_HueNr]=[Nr_Hue]		

		(* A1 ohne Hülse und ohne Werkstück *)
		IF E[eHueNr0]=0 AND E[ePceNr0]=0 THEN
			IF [Nr_Hue]<>9999 THEN
				'EH=[Chg_HueNr] 
				G77 N5000 N6000 		(Hülse einwechseln)
			ENDI
			G79 N3090			(kein Hülsenwechsel, direkt Werkstück entladen und neues laden)
		ENDI

		(* A1 ohne Hülse und mit Werkstück 20mm *)
		IF E[eHueNr0]=0 AND E[ePceNr0]<>0 THEN	
			'EL=0 G77 N3100 N3999     	(Werkstueck entladen)
			IF [Nr_Hue]<>9999 THEN      	(Kennung 20mm ohne Hülse)
				'EH=[Chg_HueNr]              	(neue Hülsennummer)
				G77 N5000 N6000        	 	(Hülse einwechseln)
			ENDI
        
			'EL=E[ePceNr1]            		(neue Werkstücknummer)
			G79 N3100                 			(neues Werkstück einwechseln) 
		ENDI

		(* A1 mit Hülse, nächste Hülsennummer gleich *)
		IF E[eHueNr0]<>0 AND E[eHueNr0]=[Nr_Hue] THEN   (nächste Hülsennummer gleich)
			G79 N3090   (kein Hülsenwechsel, direkt Werkstück entladen und neues laden)
		ENDI

		(* A1 mit Hülse oder Werkstück ohne Hülse, nächste Hülsennummer nicht gleich *)
		IF E[eHueNr0]<>0 AND E[eHueNr0]<>[Nr_Hue] THEN  
			IF E[ePceNr0]<>0 THEN		(Werkstück gespannt)
				'EL=0 G77 N3100 N3999   (Werkstueck entladen)
			ENDI
				
			IF [Nr_Hue]=9999 THEN     	(Kennung 20mm ohne Hülse)
				'EH=0 G77 N5000 N6000  	(Hülse entladen)			
			ELSE
				'EH=[Chg_HueNr]       	(neue Hülsennummer)
				G77 N5000 N6000        	(Hülse einwechseln)
			ENDI 
			'EL=E[ePceNr1]            	(neue Werkstücknummer)
			G79 N3100                	(neues Werkstück einwechseln)       					
		ENDI
	ENDI	
N3090
N3100
	G77N10500N10599			
	IF 'EL<>E[ePceNr0] THEN
		[Back]=E[ePceNr0]
		[Get]='EL
	ELSE
		[Back]=0
		[Get]=0
	ENDI
	[Next]=E[ePceNr2]
