		IF [.IBE1(6)]=1 THEN
			$Job-Manager: Warten auf Gruppe 2
		ENDI
		M261
	ENDI
	IF 'EF=4 THEN				(Platznummer auf Palette anfahren)
		E[eJobArg2]='EP
		E[eJobArg3]='EQ
	ENDI
	IF 'EF=5 OR 'EF=105 THEN	(Greiferposition anfahren)
		E[eJobArg2]='EA
		E[eJobArg3]='ED
	ENDI
	IF 'EF=6 THEN				(Greiferposition anfahren)
		E[eJobArg2]='EB
		E[eJobArg3]='ED
		E[eJobArg4]='EP
	ENDI
	IF 'EF=7 THEN				(Platznummer auf PaletteNr anfahren)
		E[eJobArg2]='ET
		E[eJobArg3]='EU
		E[eJobArg4]='EV
	ENDI
	IF 'EF=35 OR 'EF=135 THEN	(In Maschine einfahren + Greiferposition anfahren)
		E[eJobArg2]='EA
		E[eJobArg3]='ED
	ENDI
	IF 'EF=50 THEN				(Messzyklus Palette)
		E[eJobArg2]='EM
		E[eJobArg3]='EN
	ENDI
	IF 'EF=51 THEN				(Messzyklus)
		E[eJobArg2]='EM
		E[eJobArg3]='EN
	ENDI
	(IF 'EF=20 OR 'EF=120 THEN)	(Ablegen/holen)
		(E[eJobArg2]=[Dur_Back])
		(E[eJobArg3]=[Dur_Get])
		(E[eJobArg4]=[Dur_Next])
	(ENDI)
	IF 'EF=10 THEN				(X2-Achse verfahren)
		E[eJobArg2]='EX/U1
	ENDI
	IF 'EF=11 OR 'EF=111 THEN	(Y2-Achse verfahren)
		E[eJobArg2]='EY/U1
	ENDI
	
	E[eJobArg1]='F
	E[eJobSet]='EF
	IF [.IBE1(6)]=1 THEN
		$Job-Manager: Job 
		$= 'EF
		$+ aktiv
	ENDI
	IF 'EF>0 AND 'EF<100 THEN
		M263
	ENDI

	IF 'EF>99 THEN
		M264
	ENDI
	IF [.IBE1(6)]=1 THEN
