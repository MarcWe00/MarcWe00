			G77N8050N8060	(Z1 abheben)
			G77N8060N8070	(Greiferoffset kompakt berechnen [c])

			(Z1 Position mit Abheben und Kompensation berechnen)
			'Z=[PosZ_FT]+[tZHubF]-[c]+E[KompZ1]
			G90G1F[F_0]ZL925
			
			M222	(GreiferFT oeffnen)
			
			(Hauptachsen Wkst in Spannfutter)
			IF 'EL=0 THEN
				G77N8045N8050	(Nachschieben aktiv)
				G77N8075N8079
			ELSE
				G77N8045N8050	(Nachschieben aktiv)
				G77N8075N8079
