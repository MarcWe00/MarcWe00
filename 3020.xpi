M53
FOR L1=1 TO 10 DO
G90 G01 F5000

IF E40104=2 OR E40104=3 THEN
	X440 Z-300 Y-100 C-180
	X400 Z50 Y125 C15
ELSE
	X440 Z-300 Y-100 C-180 A180
	X400 Z50 Y125 C15 A0
ENDI

G79 E40129=0 N500
ENDF
C0
M40M62:1S0M5
M40M62:2S0M5
M50

G137 ES2


IF E[tolX]<>0 THEN
	L1=E[tolX]
	L2=-E[tolX]
	IF E84315>L1 OR E84315<L2 THEN
		G79 N400
	ENDI
ENDI

IF E[tolY]<>0 THEN
	L1=E[tolY]
	L2=-E[tolY]
	IF E84316>L1 OR E84316<L2 THEN
		G79 N400
	ENDI
ENDI

IF E[tolZ]<>0 THEN
