%300.0@2(Warmlaufprogramm)
(3000.xpi)

$Warmlaufprogramm 

(Parkposition)
N100
E30128=1	(aktiv)
G0 G90 X440
Y125
C0 
Z-100
M196	(Scheibentaster)

IF E40104=1 OR E40104=3 THEN
	M170	(Luentte)
ENDI

M161	(Aufraueinheit)


(Warmlaufen)
N300
VAR
[Sp] = 1
ENDV

N400
M185	(36h STO)
M186	(Bremsentest)
IF [Sp]=1 THEN
M40M62:1S4000M3
[Sp]=2
M51
ELSE
M40M62:2S4000M3
[Sp]=1
M52
M54
M55
M56
ENDI
M53
FOR L1=1 TO 10 DO
G90 G01 F2500

IF E40104=2 OR E40104=3 THEN
	X440 Z-300 Y-100 C-180
	X400 Z50 Y125 C15
ELSE
	X440 Z-300 Y-100 C-180 A180
	X400 Z50 Y125 C15 A0
ENDI

G79 E40129=0 N500
ENDF
C0
M40M62:1S0M5
M40M62:2S0M5
M50
G79 N400

(Ende)
N500
G0 G90 X440
Y125
C0 
Z-100
M40M62:1S0M5
M40M62:2S0M5
M50
$
E30128=0
N5000
M02



