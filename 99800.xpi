	[a1]=[c1]*S[alpha1]
	[b1]=[c1]*C[alpha1]
	[c2]=[NbOnRowY]-1*[sPce_Y2]
	[a2]=[c2]*S[alpha2]
	[b2]=[c2]*C[alpha2]

