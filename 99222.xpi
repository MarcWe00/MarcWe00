	[N2]=[N1]+999
	VAR H9824:1 N[N1]N[N2]	(Greiferdaten laden)

	IF [Gr_Nr]=0 OR [Gr_Nr]=1 OR [Gr_Nr]=2 THEN
		IF [MultiPal]=1 OR [PalPaare2]=1 AND [Chg_Hue]=1 THEN
			[k]=[Dur_Job]-[Dur_Null]
		ELSE
			[k]=[Dur_Pal]-[Dur_Null]
		ENDI
		
		[l]=S60/C60
		[Offs_Pal]=[k]/[l]
		[m]=[Gr_m]
		[n]=[Dur_Null]/2
		
		IF [MultiPal]=1 OR [PalPaare2]=1 AND [Chg_Hue]=1 THEN
			[o]=[Dur_Job]/2
		ELSE
			[o]=[Dur_Pal]/2
		ENDI
		
		[p]=[n]+[Offs_Pal]
		[r]=[p]-[o]
		[FreiY2]=[m]-[r]+0.1
		[Offs_Kom]=0
	ENDI
	
	
	IF [Gr_Nr]=3 OR [Gr_Nr]=4 OR [Gr_Nr]=5 OR [Gr_Nr]=6 THEN
		[FreiY2]=0.1
		[p]=[DurMess]-[Dur_Pal]
		[Offs_Pal]=[p]/2
		L1=[DurMess]*[DurMess]*[GrZVerA]
		L2=[DurMess]*[GrZVerB]
		[a]=L1+L2+[GrZVerC]
		L1=[Dur_Pal]*[Dur_Pal]*[GrZVerA]
		L2=[Dur_Pal]*[GrZVerB]
		[b]=L1+L2+[GrZVerC]
		[Offs_Kom]=[a]-[b]
	ENDI	
