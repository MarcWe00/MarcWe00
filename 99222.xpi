VAR H9820:1		(Werkstueckwechsler allgemein einlesen)
G77N10100N10199	(Werkstueckwechsler allgemein einlesen)
VAR H9823:1		(Daten Huelsenwechsel einlesen)
G77N9000N9099	(Daten Huelsenwechsel einlesen)

E11013=-1		(trapezoidale Beschleunigung)

N1000
	$Job manager: Waiting
	M262		(M-Fkt um zum Warten auf Job)
	[JobNr]=E[eJob]
	E[eJobRes]=1
	$Job manager: Job
	$= [JobNr]
	$+ active
	
	
(~~~~~ Job 1: Warten vor Beladetuere ~~~~~)	
	IF [JobNr]=1 THEN
		M226		(Z2 auf)
		G1F[F2_1]X[Pos3X2]
		Y[Pos3Y2]
	ENDI
	
	
(~~~~~ Job 2: Warten vor Beladetuere ~~~~~)	
	IF [JobNr]=2 THEN
		M226		(Z2 auf)
		G1F[F2_1]X[Pos3X2]
		Y[Pos3Y2]
	ENDI

	
(~~~~~ Job 3: Bestueckung ~~~~~)	
	IF [JobNr]=3 THEN
		M226		(Z2 auf)
		'X=[Pos4X2]
		'Y=[Pos4Y2]
		G1F[F2_1]XL923
		YL924
	ENDI
	
	
(~~~~~ Job 4: Platznummer auf Palette anfahren ~~~~~)	
	IF [JobNr]=4 THEN
		M226		(Z2 auf)
		
		'T=E[eJobArg2]	(Wkst auf Palette Nr)
		'N=E[eJobArg3]	(RT/FT)
		
		(Huelsenwechsel aktiv)
		IF [Chg_Hue]=1 THEN
			IF 'N=3 OR 'N=4 THEN
				G77N2600N2630	(Huelsen anfahren)
				G79N1000
			ENDI
		ENDI
		
		G77N2500N2510	(Palettendaten laden)	
		G77N2650N2670	(JobDurchmesser bestimmen)				
		G77N2700N2799	(Greifer berechnen)
		G77N2520N2599	(Position Palette berechnen)
		
		IF 'N=1 AND E[eGr_Akt]<>2 THEN
			IF [Chg_Hue]=1 THEN
				G1F[F2_1]X[Pos6X2]
			ELSE
				G1F[F2_1]X[Pos6X2]
			ENDI
			F[F2_5]YL924
			F[F2_5]XL923
		ENDI
		
		IF 'N=2 AND E[eGr_Akt]<>1 THEN
			IF [Chg_Hue]=1 THEN
				G1F[F2_5]X[Pos6X2]
			ELSE
				G1F[F2_5]X[Pos6X2]
			ENDI
			YL924
			XL923
		ENDI
	ENDI


(~~~~~ Job 5/105: Wechselpositionen anfahren ~~~~~)	
	IF [JobNr]=5 OR [JobNr]=105 THEN
		[A]=E[eJobArg2]	(Auswahl Wechselpositionen: 1=RT, 2=FT, 3=RT frei, 4=FT frei)
		[Dur_Job]=E[eJobArg3]
		G1F[F2_4]
		
		G77N2800N2899	(Wechselpositionen berechnen)
		YL924
	ENDI


(~~~~~ Job 6: Greiferposition freifahren ~~~~~)	
	IF [JobNr]=6 THEN
		[B]=E[eJobArg2]	(1=RT/2=FT)
		'T=E[eJobArg4]	(Wkst Nr)
		IF E[eJobArg3]<>0 THEN
			[Dur_Job]=E[eJobArg3]
		ELSE
			IF [B]=1 THEN
				[Dur_Job]=E[eDurRT]	(Durchmesser im Greifer RT)
			ENDI
		
			IF [B]=2 THEN
				[Dur_Job]=E[eDurFT]	(Durchmesser im Greifer FT)
			ENDI
		ENDI
		G1F[F2_0]
		
		(Wkst Greifer RT)
		IF [B]=1 THEN	
			[PalWkstNr]='T	(Palettendaten laden)
			G77N7100N7160	
			
			G77N2900N2999	(Palettenpositionen berechnen)
			F[F2_5]YL924
			G1F[F2_5]X[Pos6X2]	(Position X2 vor Palette Z2 ab)		
		ENDI
		
		(Wkst Greifer FT)
		IF [B]=2 THEN	
			[PalWkstNr]='T
			G77N7200N7260	(Palettendaten laden)
			G77N2900N2999	(Palettenpositionen berechnen)
			F[F2_5]YL924
			G1F[F2_5]X[Pos6X2]	(Position X2 vor Palette Z2 ab)
		ENDI
	
		(Huelse Greifer RT)
		IF [B]=3 THEN	
			G1G91Y-2
			G90
			F[F2_5]X[Pos5X2]
		ENDI
	
		(Huele Greifer FT)
		IF [B]=4 THEN	
			G1G91Y2
			G90
			F[F2_5]X[Pos5X2]
		ENDI
	ENDI
	
	
(~~~~~ Job 7: Platznummer auf PaletteNr anfahren ~~~~~)	
	IF [JobNr]=7 THEN
		M226
		'T=E[eJobArg3]
		'N=E[eJobArg4]
		'Q=E[eJobArg2]
		IF [Chg_Hue]=1 THEN
			IF 'N=3 OR 'N=4 THEN
				G77N2600N2630	(Huelsen anfahren)
				G79N1000
			ENDI
		ENDI
		G77N2510N2520	(Palettendaten laden)
		[Dur_Job] = [Dur_Pal]	
		G77N2700N2799	(Greifer berechnen)
		[WkstNr_Pal]='T
		G77N2520N2599	(Palettenposition berechnen)			

		IF 'N=1 THEN( AND E[eGr_Akt]<>2 THEN)
			IF [Chg_Hue]=1 THEN
				G1F[F2_1]X[Pos6X2]	(Position X2 vor Palette Z2 ab)
			ELSE
				G1F[F2_1]X[Pos6X2]	(Position X2 vor Palette Z2 ab)
			ENDI
			F[F2_5]YL924
			F[F2_5]XL923
		ENDI
		
		IF 'N=2 AND E[eGr_Akt]<>1 THEN
			IF [Chg_Hue]=1 THEN
				G1F[F2_5]X[Pos6X2]	(Position X2 vor Palette Z2 ab)
			ELSE
				G1F[F2_5]X[Pos6X2]	(Position X2 vor Palette Z2 ab)
			ENDI
			YL924
			XL923
		ENDI
	ENDI
	
	
(~~~~~ Job 50: Messzyklus ~~~~~)	
IF [JobNr]=50 THEN
	'M=E[eJobArg2]	(Messauswahl)
	'N=E[eJobArg3]

	G77N7080N7099	(Palettendaten laden)
 	[MultiPal]=E40169

	(Palettenloch ausmessen)
	IF 'M=3 THEN
		G77N3900N4000 (Palettenloch ausmessen)
	ENDI

	(Paletten vermessen)
	IF 'M=1 OR 'M=2 THEN
		IF [MultiPal]=1 THEN
			G77N6000N6700	(Universalpalette vermessen)
		ELSE
			G77N3000N3700	(Palette vermessen)
		ENDI
	ENDI

	(X2 Nullpunkt vermessen)
	IF 'M=4 THEN
		E[MessErg1] = UE70000	(X2 Position ablegen)	
	ENDI
	(Y2 Nullpunkt vermessen)
	IF 'M=5 THEN
		G77N6800N6899
	ENDI
ENDI


(~~~~~ Job 51: Messzyklus ~~~~~)
IF [JobNr]=51 THEN
	'M=E[eJobArg2]
	'N=E[eJobArg3]	(Auswahl Messfahrt)
	G77N3700N3800	(~~~~~ Messfahrten ~~~~~)
ENDI


(~~~~~ Job 10: X2-Achse verfahren ~~~~~)
IF [JobNr]=10 THEN
	'X=UE[eJobArg2]
	G77N2000N2099	(Vorschub setzen)
	XL923
ENDI


(~~~~~ Job 11/111: y2-Achse verfahren ~~~~~)
IF [JobNr]=11 OR [JobNr]=111 THEN
	'Y=UE[eJobArg2]
	G77N2000N2099	(Vorschub setzen)
	YL924
ENDI


(~~~~~ Job 20/120: Wkst Ablegen/holen ~~~~~)
IF [JobNr]=20 OR [JobNr]=120 THEN
	IF [JobNr]=120 THEN
		G04F3
	ENDI
	
	M226	(Z2 hoch)
	
	(Greifer RT kein Wkst)
	IF E[eGrZ_RT]<2 OR E[ePceGrRT]=0 THEN
		M220	(GreiferRT auf)
		
		(Belegung anpassen)
		E[ePceGrRT]=0
		E[eDurRT]=0
	ENDI
	
	(Greifer FT kein Wkst)
	IF E[eGrZ_FT]<2 OR E[ePceGrFT]=0 THEN
		M222	(GreiferFT auf)
		
		(Belegung anpassen)
		E[ePceGrFT]=0
		E[eDurFT]=0
	ENDI
	
	
	(Wkst Nr in GreiferFT -> ablegen)
	IF E[ePceGrFT]>0 THEN
		$Unload piece:
		$= E[ePceGrFT]
		$+ Pal FT
		'T=E[ePceGrFT]
		'N=2
		G77N2500N2510	(Palettendaten laden)
		(Huelenwechsler aktiv + Universalpalette)
		IF [MultiPal]=1 OR [PalPaare2]=1 AND [Chg_Hue]=1 THEN
			IF E[eHueNr0]<>0 THEN				
				[HuelseNr]=E[eHueNr0]   	(HuelsenNr laden)
				G77N8000N8110
				
				[Dur_Job]=[Dur_Hue]				
			ENDI
		ELSE
			[Dur_Job]=E[eDurFT]
		ENDI
		
		G77N2500N2510	(Palettendaten laden)
		G77N2700N2799	(Greifer berechnen)
		G77N2520N2599	(Position Palette berechnen)
		
		IF [Chg_Hue]=1 THEN
			G90G1F[F2_5] X[Pos6X2] 	(Position X2 vor Palette Z2 ab)
		ELSE
			G90G1F[F2_5] X[Pos6X2]	(Position X2 vor Palette Z2 ab)
		ENDI
	
		(Palettenpositionen anfahren)
		IF [MultiPal]=1 THEN
			[y2]='Y+0.2
			F[F2_5]Y[y2]
			F[F2_5]XL923
			
			M227	(Z2 runter)
			
			F100 YL924
			F[F2_1]
		ELSE
			F[F2_5]YL924
			F[F2_5]XL923  
			
			M227 (Z2 runter)
		ENDI      
	
		M222	(GreiferFT oeffnen)
		
		G1G91F[F2_5]Y[FreiY2]		(Y2 frei fahren)
		
		IF [Chg_Hue]=1 THEN
			G1G90F[F2_5]X[Pos6X2]	(Position X2 vor Palette Z2 ab)
		ELSE
			G1G90F[F2_5]X[Pos6X2]	(Position X2 vor Palette Z2 ab)
		ENDI
	
		M226	(Z2 hoch)
		G90
		
		(Belegung aktualisieren)
		E[ePceGrFT]=0
		E[eDurFT]=0
	ENDI
	
	
	(Wkst Nr in GreiferRT -> ablegen)
	IF E[ePceGrRT]>0 THEN
		IF E[eLdGet]=0 THEN
			$Unload piece:
			$= E[ePceGrRT]
			$+ Pal RT
			'T=E[ePceGrRT]
			'N=1
			G77N2500N2510	(Palettendaten laden)
			(Huelenwechsler aktiv + Universalpalette)
			IF [MultiPal]=1 OR [PalPaare2]=1 AND [Chg_Hue]=1 THEN
				(WkstNr in GreiferRT = WkstNr neues Wkst)
				IF E[ePceGrRT]=E[ePceNr1] THEN
					IF E[eHueNr0]<>0 THEN
						[HuelseNr]=E[eHueNr0]   	(HuelsenNr laden)
						G77N8000N8110
					
						[Dur_Job]=[Dur_Hue]				
					ENDI
				ELSE
					[Dur_Job]=E[eDurRT] 
				ENDI
			ENDI
			
			G77N2500N2510	(Palettendaten laden)
			G77N2700N2799	(Greifer berechnen)
			G77N2520N2599	(Position Palette berechnen)
	
			M226	(Z2 hoch)
	
			IF [Chg_Hue]=1 THEN
				G9G1F[F2_1]X[Pos6X2]	(Position X2 vor Palette Z2 ab)
			ELSE
				G9G1F[F2_1]X[Pos6X2]	(Position X2 vor Palette Z2 ab)
			ENDI
			
			(Palettenpositionen anfahren)
			IF [MultiPal]=1 THEN
				[y2]='Y+0.2
				F[F2_5]Y[y2]
				F[F2_5]XL923
			
				M227	(Z2 runter)
			
				F100 YL924
				F[F2_1]
			ELSE
				F[F2_5]YL924
				F[F2_5]XL923
		
				M227	(Z2 runter)
			ENDI
		
			M220	( GreiferRT oeffnen)
		
			G1G91F[F2_5]Y-[FreiY2]	(Y2 frei fahren)
	
			IF [Chg_Hue]=1 THEN
				G1G90F[F2_5]X[Pos6X2] 	(Position X2 vor Palette Z2 ab)
			ELSE
				G1G90F[F2_5]X[Pos6X2]	(Position X2 vor Palette Z2 ab)
			ENDI      
	
			G90
			M226	(Z2 hoch)
	
			(Belegung aktualisieren)
			E[ePceGrRT]=0
			E[eDurRT]=0
		ELSE
			(Meldung ausgeben)
			IF E[ePceGrRT]<>E[eLdGet] THEN
				$Unload piece:
				$= E[ePceGrRT]
				$+ Pal:
				$= RT
				E[MeldNr]=20
				G79 N5100
			ELSE
			ENDI
		ENDI
	ENDI

	(keine WkstNr in GreiferRT + WkstNr laden > 0 -> laden)
	IF E[ePceGrRT]=0 AND E[eLdGet]>0 THEN
		$Load piece:
		$= E[eLdGet]
		$+ Pal RT
		'T=E[eLdGet]
		'N=1
		G77N2500N2510	(Palettendaten laden)
		(Huelenwechsler aktiv + Universalpalette)
		IF [MultiPal]=1 OR [PalPaare2]=1 AND [Chg_Hue]=1 THEN
			(WkstNr in GreiferRT = naechste WkstNr)
			IF E[eLdGet]=E[ePceNr2] THEN
				[Dur_Job]=E[ePceSL2]/1000	(Durchmesser naechstes Wkst uebernehmen)
			ELSE				
				IF E[eHueNr0]<>0 THEN
					[HuelseNr]=E[eHueNr0]   	(HuelsenNr laden)
					G77N8000N8110					
					
					[Dur_Job]=[Dur_Hue]				
				ENDI				
			ENDI
		ENDI
		
		G77N2500N2510	(Palettendaten laden)	
		G77N2700N2799	(Greifer berechnen)
		G77N2520N2599	(Position Palette berechnen)
		
		M226	(Z2 hoch)

		IF [Chg_Hue]=1 THEN
			G9G1F[F2_5]X[Pos6X2]	(Position X2 vor Palette Z2 ab)
		ELSE
			G9G1F[F2_5]X[Pos6X2]	(Position X2 vor Palette Z2 ab)
		ENDI
	
		M327	(fly - Z2 runter)

		G9G1F[F2_5]
		YL924
		G91G1F[F2_5]Y-[FreiY2]
		G90
		M227	(Z2 runter)
		F[F2_5]XL923
		F[F2_5]YL924
		M221	(GreiferRT schliessen)
		
		(Universalpalette frei fahren)
		IF [MultiPal]=1 THEN
			[y2]='Y+0.2
			F100 Y[y2]
			F[F2_1]
		ENDI
		
		M226	(Z2 hoch)
	
		(keine Wkst im GreiferRT)
		IF E[eGrZ_RT]=1 THEN
			M220	(GreiferRT oeffnen)
			
			(Belegung aktualisieren)
			E[ePceGrRT]=0
			E[eDurRT]=0
			
			(Job Resultat: fehlgeschlagen)
			E[eJobRes]=10
		ELSE
			(Belegung aktualisieren)
			E[ePceGrRT]=E[eLdGet]
			IF E[eLdGet]=E[ePceNr1] THEN
				E[eDurRT]=E[ePceSL1]/1000
			ENDI
			IF E[eLdGet]=E[ePceNr2] THEN
				E[eDurRT]=E[ePceSL2]/1000
			ENDI
			
			(Job Resultat: erfolgreich)
			E[eJobRes]=2
		ENDI
	ENDI

	'N=1
	IF [Chg_Hue]=1 THEN
		G1F[F2_5]X[Pos6X2]	(Position X2 vor Palette Z2 ab)
	ELSE
		G1F[F2_5]X[Pos6X2]	(Position X2 vor Palette Z2 ab)
	ENDI
	
	M226	(Z2 hoch)
	IF [Chg_Hue]=1 THEN
		G1F[F2_5]X[Pos6X2]	(Position X2 vor Palette Z2 ab)
	ELSE
		G1F[F2_5]X[Pos6X2]	(Position X2 vor Palette Z2 ab)
	ENDI
	
	F[F2_5]Y[Pos3Y2]	(Position Y2 Warten vor Beladetuere)
ENDI


(~~~~~ Job 30/130: In Maschinenraum einfahren ~~~~~)
IF [JobNr]=30 OR [JobNr]=130 THEN
	$In Maschinenraum einfahren

	M300	(Beladetuer oeffnen - fly)
	M226	(Z2 hoch)
	
	EG70
	M200	(Beladetuer oeffnen)
	G1F[F_0]X[Pos1X2]	(Position X2 Wechsel)
	
	(Job Resultat: erfolgreich)
	E[eJobRes]=2
	EG100
ENDI


(~~~~~ Job 35/135: In Maschinenraum einfahren + Y2 auf Position ~~~~~)
IF [JobNr]=35 OR [JobNr]=135 THEN
	$In Maschinenraum einfahren
	[A]=E[eJobArg2]	(Auswahl Wechselpositionen: 1=RT, 2=FT, 3=RT frei, 4=FT frei)
	[Dur_Job]=E[eJobArg3]

	M300	(Beladetuer oeffnen - fly)
	M226	(Z2 hoch)

	EG70		
	G77N2800N2899	(Wechselpositionen berechnen)	
	M200	(Beladetuer oeffnen)
	G1F[F_0]X[Pos2SinX2]	(Position X2 Zwischenposition)	
	G1F[F_0]X[Pos1X2]YL924	(Position X2+Y2 Wechsel)	
	(Job Resultat: erfolgreich)
	E[eJobRes]=2
	EG100
ENDI


(~~~~~ Job 31/131: Aus Maschinenraum ausfahren ~~~~~)
IF [JobNr]=31 OR [JobNr]=131 THEN
