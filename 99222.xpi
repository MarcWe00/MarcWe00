		'Y=[yPal0]+[a1]-[b2]+[Offs_Kor]
	ELSE
		'Y=[yPal0]+[a1]-[b2]-[Offs_Kor]
	ENDI

	IF [MultiPal]=1 AND [Chg_Hue]=1 THEN
		[s]=[Dur_Job]/2
		[r]=[s]/C30 
		IF [NbPce_X2]=8 THEN          
		   [t]=[r]-0.386
		ELSE
		   [t]=[r]-0.232
		ENDI
	ENDI

	IF [MultiPal]=1 AND [Chg_Hue]=0 THEN
		[s]=[Dur_Pal]/2
		[r]=[s]/C30   
		IF [NbPce_X2]=8 THEN          
		   [t]=[r]-0.386
		ELSE
