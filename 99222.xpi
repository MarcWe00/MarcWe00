			E[eHueGrRT]=E[eHueGet]
			
			(Job Resultat: erfolgreich)
			E[eJobRes]=2
			M226
		ENDI
	ENDI
	
	G1F[F2_5]X[Pos7X2]	(Position X2 quer mit Huelse)
