		[b2]=[c2]*C[WinkelX]
		[PX1]=[PX1]-[b1]+[a2]
		[PY1]=[PY1]-[a1]+[b2]
	ENDI
	
	(NUR bei ERSTER Messung Kompensationswert fuer X2 bestimmen)
