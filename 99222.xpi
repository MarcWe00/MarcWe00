			[temp2]= [NbPce_X2]-1*[sPce_X2]
			E[KompX]=[temp1]/[temp2]
		ENDI
	ENDI
	
	(Messerergebnisse ablegen)
	E[PalMessErg1]=[PX1]
	E[PalMessErg2]=[PY1]
	E[PalMessErg3]=[WinkelY]
	E[PalMessErg4]=[WinkelX]
	
	
	
