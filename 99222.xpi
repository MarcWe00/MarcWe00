		[k]=[DurMess]-[Dur_Null]
		[l]=S60/C60
		[Offs_Ref]=[k]/[l]
		IF [MultiPal]=1 AND [Chg_Hue]=1 THEN
			[m]=[Dur_Job]-[Dur_Null]
		ELSE
			[m]=[Dur_Pal]-[Dur_Null]
		ENDI
		[n]=[m]/[l]
		[Offs_Kor]=[Offs_Ref]-[n]
	ENDI
	
	IF [Gr_Nr]=3 OR [Gr_Nr]=4 OR [Gr_Nr]=5 OR [Gr_Nr]=6 THEN
		[FreiY2]=0.2
		[a]=[DurMess]-[Dur_Pal]
		[Offs_Kor]=[a]/2
	ENDI
