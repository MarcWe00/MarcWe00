	IF E[eHueGrRT]>0 THEN
		IF E[eHueGet]=0 THEN
			$Unload piece:
			$= E[eHueGrRT]
			$+ Sleeve RT
			
			(Huelsendaten laden)
			[HuelseNr]=E[eHueGrRT]*1000	(HuelsenNr laden)
			G77N8000N8199
			
			G9G1F[F2_1] X[Pos7X2]	(Position X2 quer mit Huelse)
			
			(Huelsenposition anfahren)
			'X=[X2SleRT]
			'Y=[Y2SleRT]
			F[F2_5]YL924
			F[F2_5]XL923
			
			M227	(Z2 runter)
			M220	(GreiferRT auf)
			
			(Huelse freifahren)
			'X=[X2SleRT]+[FrHueX2]
			'Y=[Y2SleRT]-[FrHueY2]
			G01 G90 F[F_1] YL924
			XL923
			
			(Belegung aktualisieren)
			E[eHueGrRT]=0
			
			M226	(Z2 hoch)
			
			G01 G90 F[F2_5] X[Pos7X2]	(Position X2 quer mit Huelse)
		ELSE
			(Meldung ausgeben)
			IF E[eHueGrRT]<>E[eHueGet] THEN
				$Unload piece:
				$= E[eHueGrRT]
				$+ Pal:
				$= RT
				E[MeldNr]=20
				G79 N5100
			ENDI
		ENDI
	ENDI

	(keine HuelsenNr in GreiferRT + HuelsenNr laden > 0 -> laden)
	IF E[eHueGrRT]=0 AND E[eHueGet]>0 THEN
		$Load piece:
		$= E[eHueGet]
		$+ Sleeve RT
		
		(Huelsendaten laden)
		[HuelseNr]=E[eHueGet](*1000) 	(HuelsenNr laden)
		G77N8000N8199
		
