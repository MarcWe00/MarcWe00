	IF [RichtPal]=0 THEN
		[NbOnRowY]=[T]-1/[NbPce_X2]
		[NbOnRowY]=T[NbOnRowY]+1
		[NbOnRowX]=[NbOnRowY]-1*[NbPce_X2]
		[NbOnRowX]=[T]-[NbOnRowX]
	ELSE
		[NbOnRowX]=[T]-1/[NbPce_Y2]
		[NbOnRowX]=T[NbOnRowX]+1
		[NbOnRowY]=[NbOnRowX]-1*[NbPce_Y2]
		[NbOnRowY]=[T]-[NbOnRowY]
	ENDI
	
	IF [N]=1 THEN
		[xPal0]=[xPalRT_1]
		[yPal0]=[yPalRT_1]
		[alpha1]=[alphaYRT]
		[alpha2]=[alphaXRT]
		[NbOnRowX]=[NbPce_X2]-[NbOnRowX]+1
	ELSE
		[xPal0]=[xPalFT_1]
		[yPal0]=[yPalFT_1]
		[alpha1]=[alphaYFT]
		[alpha2]=[alphaXFT]
	ENDI
	[c1]=[NbOnRowX]-1*[sPce_X2]
	[a1]=[c1]*S[alpha1]
	[b1]=[c1]*C[alpha1]
	[c2]=[NbOnRowY]-1*[sPce_Y2]
	[a2]=[c2]*S[alpha2]
	[b2]=[c2]*C[alpha2]

	G77 N4000N4199	(Offset berechnen)
	'X=[xPal0]-[Offs_Kom]+[b1]-[a2]*E[KompX]

