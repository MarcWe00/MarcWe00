        M232      (X2 zurück)
        M227      (Z2-Achse ab)
        M220      (Greifer RT öffnen)
        M231      (X2-Achse vor)
        (M226)      (Z2-Achse auf)
        E[ePceGrRT]=0
        E[eDurRT]=0
      ELSE
        IF E[ePceGrRT]<>E[eLdGet] THEN
          $Unload piece:
          $= E[ePceGrRT]
          $+ Pal:
          $= RT
          E30225=20
          G79 N5100
        ENDI

      ENDI	
    ENDI

    IF E[ePceGrRT]=0 AND E[eLdGet]>0 THEN
      $Load piece:
      $= E[eLdGet]
      $+ Pal RT
      'T=E[eLdGet]
      'N=1
      G77 N2500 N2599
      G1 F[F2_6]
      EG30
      XL923
      M220
      (M226)
      M231
