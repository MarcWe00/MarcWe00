        $Wechsler Rohteil nicht gefunden
        E30225=30
        G79 N5100
      ELSE
        E[ePceGrRT]=E[eLdGet]
        
        IF E[eLdGet]=E[ePceNr1] THEN
          E[eDurRT]=E[ePceSL1]/1000
        ENDI

        M226
        M231
        E[eJobRes]=2
      ENDI
    ENDI
    

    IF E[eLdGet]=0 AND E[ePceNr0]<>0 THEN
